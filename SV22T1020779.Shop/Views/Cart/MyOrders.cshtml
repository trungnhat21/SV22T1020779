@using SV22T1020779.Models.Sales
@model IEnumerable<OrderViewInfo>

@{
    ViewBag.Title = "Đơn hàng của tôi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold text-primary mb-0">
            <i class="fa-solid fa-boxes-stellar me-2"></i>Đơn hàng của tôi
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/" class="btn btn-outline-secondary btn-sm shadow-sm">
                        <i class="fa fa-home me-1"></i> Trang chủ
                    </a>
                </li>
                <li class="breadcrumb-item active">Đơn hàng</li>
            </ol>
        </nav>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-center" style="width: 100px;">Mã đơn</th>
                            <th style="width: 160px;">Ngày đặt</th>
                            <th>Địa chỉ nhận hàng</th>
                            <th style="width: 200px;">Người giao</th>
                            <th style="width: 150px;">Số điện thoại</th>
                            <th class="text-center" style="width: 160px;">Trạng thái</th>
                            <th class="text-end" style="width: 150px;">Tổng tiền</th>
                            <th class="text-center" style="width: 120px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-secondary">#@item.OrderID</td>
                                    <td>
                                        <div class="small text-muted">@item.OrderTime.ToString("dd/MM/yyyy")</div>
                                        <div class="fw-bold">@item.OrderTime.ToString("HH:mm")</div>
                                    </td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@item.DeliveryAddress">
                                        @item.DeliveryAddress
                                    </td>

                                    <td>
                                        @if (item.Status == OrderStatusEnum.Rejected || item.Status == OrderStatusEnum.Cancelled)
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                        else if (string.IsNullOrEmpty(item.ShipperName))
                                        {
                                            <span class="text-muted italic small">
                                                <i class="fa-solid fa-spinner fa-spin me-1"></i>Đang sắp xếp...
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fa-solid fa-user-tie text-primary me-2"></i>
                                                <strong class="text-primary">@item.ShipperName</strong>
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        @if (string.IsNullOrEmpty(item.ShipperPhone) || item.Status == OrderStatusEnum.Rejected || item.Status == OrderStatusEnum.Cancelled)
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                        else
                                        {
                                            <a href="tel:@item.ShipperPhone" class="text-decoration-none text-dark">
                                                <i class="fa-solid fa-phone-volume me-1 text-success small"></i>@item.ShipperPhone
                                            </a>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @switch (item.Status)
                                        {
                                            case OrderStatusEnum.New:
                                                <span class="badge rounded-pill bg-warning text-dark px-3">
                                                    <i class="fa-solid fa-clock me-1"></i>Chờ duyệt
                                                </span>
                                                break;
                                            case OrderStatusEnum.Accepted:
                                                <span class="badge rounded-pill bg-primary px-3">
                                                    <i class="fa-solid fa-check me-1"></i>Đã duyệt
                                                </span>
                                                break;
                                            case OrderStatusEnum.Shipping:
                                                <span class="badge rounded-pill bg-info px-3">
                                                    <i class="fa-solid fa-truck-fast me-1"></i>Đang giao
                                                </span>
                                                break;
                                            case OrderStatusEnum.Completed:
                                                <span class="badge rounded-pill bg-success px-3">
                                                    <i class="fa-solid fa-circle-check me-1"></i>Hoàn tất
                                                </span>
                                                break;
                                            case OrderStatusEnum.Cancelled:
                                                <span class="badge rounded-pill bg-danger px-3">
                                                    <i class="fa-solid fa-ban me-1"></i>Đã hủy
                                                </span>
                                                break;
                                            case OrderStatusEnum.Rejected:
                                                <span class="badge rounded-pill bg-secondary px-3">
                                                    <i class="fa-solid fa-circle-xmark me-1"></i>Từ chối
                                                </span>
                                                break;
                                            default:
                                                <span class="badge rounded-pill bg-dark px-3">Không xác định</span>
                                                break;
                                        }
                                    </td>

                                    <td class="text-end fw-bold">
                                        <span class="text-dark">@item.TotalPrice.ToString("N0")</span>
                                        <small class="text-danger ms-1">VNĐ</small>
                                    </td>

                                    <td class="text-center">
                                        <a href="~/Cart/OrderDetail/@item.OrderID" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="fa-solid fa-magnifying-glass me-1"></i>Xem
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-inbox fa-3x mb-3 d-block"></i>
                                    Bạn chưa có đơn hàng nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table thead th {
            border-top: none;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .italic {
            font-style: italic;
        }

        .badge {
            font-weight: 500;
            font-size: 0.8rem;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(0,123,255,0.03);
        }
    </style>
}