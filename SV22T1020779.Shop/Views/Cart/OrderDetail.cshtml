@model IEnumerable<SV22T1020779.Models.Sales.OrderDetailViewInfo>
@{
    var order = ViewBag.Order as SV22T1020779.Models.Sales.OrderViewInfo;
}

<div class="container mt-4">
    <h4 class="text-uppercase">Chi tiết đơn hàng #@order?.OrderID</h4>
    <p>Ngày đặt: <b>@order?.OrderTime.ToString("dd/MM/yyyy HH:mm")</b></p>

    <div class="table-responsive bg-white p-3 shadow-sm rounded">
        <table class="table table-bordered align-middle mt-0 mb-0">
            <thead class="table-light">
                <tr style="border-bottom: 2px solid #dee2e6;">
                    <th class="py-3">Tên mặt hàng</th>
                    <th class="text-center py-3">Số lượng</th>
                    <th class="text-end py-3">Đơn giá</th>
                    <th class="text-end py-3">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model)
                {
                    <tr>
                        <td class="py-3">@detail.ProductName</td>
                        <td class="text-center">@detail.Quantity</td>
                        <td class="text-end">@detail.SalePrice.ToString("N0")</td>
                        <td class="text-end fw-bold">
                            @((detail.Quantity * detail.SalePrice).ToString("N0")) <span class="text-danger small">VNĐ</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="container mt-4">
        <div class="d-flex gap-2">
            <a href="/Cart/MyOrders" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Quay lại
            </a>

            @if (order?.Status == OrderStatusEnum.New)
            {
                <form asp-action="CancelOrder" asp-controller="Cart" method="post"
                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không? Hành động này không thể hoàn tác.');">
                    <input type="hidden" name="id" value="@order.OrderID" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fa fa-trash"></i> Hủy đơn hàng
                    </button>
                </form>
            }
        </div>
    </div>
</div>
<style>
    .bg-white {
        background-color: #ffffff !important;
    }

    .table {
        --bs-table-bg: #ffffff !important;
        background-color: #ffffff !important;
    }

        .table th, .table td {
            background-color: #ffffff !important;
            border-color: #dee2e6 !important;
        }

        .table thead th {
            background-color: #f8f9fa !important;
            color: #333;
            font-weight: 600;
        }
</style>