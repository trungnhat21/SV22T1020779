@model SV22T1020779.Models.Common.PagedResult<Product>
@{
    Layout = null;
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger shadow-sm border-0 mb-4 rounded-3">
        <ul class="mb-0 small ps-3">
            @foreach (var state in ViewData.ModelState.Values)
            {
                foreach (var error in state.Errors)
                {
                    <li><i class="fa-solid fa-circle-exclamation me-2"></i>@error.ErrorMessage</li>
                }
            }
        </ul>
    </div>
    return;
}

@if (Model.DataItems.Count == 0)
{
    <div class="text-center p-5 bg-light rounded-4 border">
        <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
        <p class="text-muted fw-bold">Không tìm thấy mặt hàng nào phù hợp với yêu cầu của bạn.</p>
        <button class="btn btn-sm btn-outline-primary mt-2" onclick="location.reload()">Xem tất cả sản phẩm</button>
    </div>
    return;
}

<div id="productSlide" class="carousel slide" data-bs-ride="false">
    <div class="carousel-inner">
        @{
            int itemsPerSlide = 9;
            int totalItems = Model.DataItems.Count;
            int totalSlides = (int)Math.Ceiling((double)totalItems / itemsPerSlide);
        }

        @for (int i = 0; i < totalSlides; i++)
        {
            <div class="carousel-item @(i == 0 ? "active" : "")">
                <div class="row g-4">
                    @foreach (var item in Model.DataItems.Skip(i * itemsPerSlide).Take(itemsPerSlide))
                    {
                        <div class="col-md-4">
                            <div class="card h-100 product-card border-0 shadow-sm">
                                <div class="text-center p-2" style="height:180px">
                                    <img src="@(string.IsNullOrEmpty(item.Photo) ? Url.Content("~/images/products/nophoto.png") : Url.Content($"~/images/products/{item.Photo}"))"
                                         style="max-height:100%; object-fit:contain"
                                         class="card-img-top"
                                         alt="@item.ProductName">
                                </div>
                                <div class="card-body d-flex flex-column text-center">
                                    <h6 class="card-title fw-bold text-truncate">@item.ProductName</h6>
                                    <p class="text-primary fw-bold mb-2">@item.Price.ToString("N0") <span class="text-danger small">VNĐ</span></p>
                                    <div class="d-flex gap-2 mt-auto">
                                        <a href="~/Product/Detail/@item.ProductID" class="btn btn-sm btn-outline-primary w-100 rounded-pill">Chi tiết mặt hàng</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (totalSlides > 1)
    {
        <button class="carousel-control-prev custom-btn" type="button" data-bs-target="#productSlide" data-bs-slide="prev">
            <span class="fa fa-chevron-left text-dark fs-5"></span>
        </button>
        <button class="carousel-control-next custom-btn" type="button" data-bs-target="#productSlide" data-bs-slide="next">
            <span class="fa fa-chevron-right text-dark fs-5"></span>
        </button>
    }
</div>

<style>
    .custom-btn {
        width: 40px;
        height: 40px;
        background: #fff;
        border-radius: 50%;
        top: 50%;
        transform: translateY(-50%);
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        border: 1px solid #eee;
        opacity: 0.9;
        z-index: 10;
        transition: all 0.3s;
    }

    .carousel-control-prev.custom-btn {
        left: -20px;
    }

    .carousel-control-next.custom-btn {
        right: -20px;
    }

    .custom-btn:hover {
        background: #0d6efd;
        opacity: 1;
        border-color: #0d6efd;
    }

        .custom-btn:hover span {
            color: #fff !important;
        }

    .product-card {
        transition: transform 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }
</style>