@model SV22T1020779.Models.Catalog.Product
@{
    ViewData["Title"] = Model.ProductName;
}

<div class="container mt-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <a href="/" class="btn btn-outline-secondary btn-sm shadow-sm">
            <i class="fa fa-home me-1"></i> Trang chủ
        </a>
        <span class="mx-2 text-muted">/</span>
        <span class="text-primary fw-bold">@Model.ProductName</span>
    </nav>

    <div class="row bg-white p-4 shadow-sm rounded-4 border border-light">
        <div class="col-md-5 text-center p-3">
            <div class="p-2 rounded-3" style="border: 3px solid #0d6efd;">
                <img src="@(string.IsNullOrEmpty(Model.Photo) ? "/images/products/nophoto.png" : $"/images/products/{Model.Photo}")"
                     class="img-fluid rounded-2"
                     style="max-height: 400px; width: 100%; object-fit: contain; background: #f8f9fa;">
            </div>
        </div>

        <div class="col-md-7 ps-md-5">
            <h2 class="text-primary fw-bold mb-4 mt-3">CHI TIẾT MẶT HÀNG</h2>

            <div class="mb-4">
                <h4 class="mb-3 text-dark">
                    <span class="fw-light">Tên mặt hàng:</span> <strong>@Model.ProductName</strong>
                </h4>

                <h3 class="text-danger fw-bold mb-3">
                    <span class="text-dark fw-light h4">Giá bán:</span> @Model.Price.ToString("N0") <small>VNĐ</small>
                </h3>

                <hr class="text-muted opacity-25">

                <p class="text-muted mb-2">
                    <i class="fa fa-tag me-2 text-primary"></i><strong>Đơn vị tính:</strong> @Model.Unit
                </p>

                <p class="text-justify text-secondary" style="line-height: 1.6;">
                    @Model.ProductDescription
                </p>
            </div>

            <form action="/Cart/AddToCart" method="post" class="mt-5 p-4 bg-light rounded-4 border">
                <input type="hidden" name="productID" value="@Model.ProductID" />
                <input type="hidden" name="salePrice" value="@Model.Price" />

                <div class="row align-items-center">
                    <div class="col-sm-4 mb-3 mb-sm-0">
                        <div class="input-group">
                            <span class="input-group-text bg-white">Số lượng</span>
                            <input type="number" name="quantity" value="1" min="1" class="form-control text-center fw-bold">
                        </div>
                    </div>
                    <div class="col-sm-8">
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow">
                            <i class="fa-solid fa-cart-plus me-2"></i>THÊM VÀO GIỎ HÀNG
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>