@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{

    var userDisplayName = HttpContextAccessor.HttpContext.Session.GetString("UserDisplayName");
}

<nav class="navbar navbar-expand-lg navbar-light bg-white fixed-top shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold text-primary fs-3" href="/">W/n <span class="text-dark">SHOP</span></a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item me-3">
                    <a class="nav-link position-relative" href="~/Cart/">
                        <i class="fa-solid fa-cart-shopping fs-5"></i>
                        @await Component.InvokeAsync("CartBadge")
                    </a>
                </li>

                <li class="nav-item me-3">
                    <a class="nav-link position-relative" href="~/Cart/MyOrders" title="Đơn hàng của tôi">
                        <i class="fa-solid fa-clipboard-list fs-5"></i>
                        <span class="d-lg-none ms-2">Đơn hàng</span>
                    </a>
                </li>

                <li class="nav-item me-3">
                    <a class="nav-link position-relative" href="~/Cart/OrderHistory" title="Lịch sử mua hàng">
                        <i class="fa-solid fa-clock-rotate-left fs-5 text-secondary"></i>
                        <span class="d-lg-none ms-2">Lịch sử mua hàng</span>
                    </a>
                </li>
                @if (!string.IsNullOrEmpty(userDisplayName))
                {

                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center bg-light rounded-pill px-3 py-1 shadow-sm border border-primary-subtle"
                           href="/Account/Profile"
                           style="transition: all 0.3s;">

                            <span class="fw-bold text-dark me-2 small">
                                @userDisplayName
                            </span>

                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 32px; height: 32px;">
                                <i class="fa-solid fa-user" style="font-size: 0.85rem;"></i>
                            </div>
                        </a>
                    </li>


                    <li class="nav-item ms-2">
                        <a class="nav-link text-danger p-0" href="/Account/Logout" title="Đăng xuất">
                            <i class="fa-solid fa-right-from-bracket ms-2 fs-5"></i>
                        </a>
                    </li>
                }
                else
                {

                    <li class="nav-item">
                        <a class="btn btn-outline-primary me-2 btn-sm px-3 shadow-sm rounded-0" href="/Account/Login">Đăng nhập</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary btn-sm px-3 shadow-sm rounded-0" href="/Account/Register">Đăng ký</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<style>
    body {
        padding-top: 80px;
    }

    .nav-link.bg-light:hover {
        background-color: #e2e6ea !important;
        transform: translateY(-2px);
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
    }

    .navbar-nav .nav-link:hover i {
        color: #007bff !important;
        transition: all 0.3s ease;
        transform: scale(1.2);
    }

    .nav-link.text-danger:hover i {
        color: #dc3545 !important;
        transform: scale(1.2);
    }

    .navbar-nav .nav-link i {
        transition: all 0.3s ease;
    }

    .nav-link:hover .text-secondary {
        color: #007bff !important;
    }
</style>