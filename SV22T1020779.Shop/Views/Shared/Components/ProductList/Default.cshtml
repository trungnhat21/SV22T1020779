@model IEnumerable<SV22T1020779.Models.Catalog.Product>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 product-card border-0 shadow-sm p-2">
                <div style="height: 200px; display: flex; align-items: center; justify-content: center; background: #f8f9fa;" class="rounded-3 overflow-hidden">
                    <img src="@(string.IsNullOrEmpty(item.Photo) || item.Photo == "nophoto.png" ? "https://via.placeholder.com/300x200?text=No+Image" : $"/images/products/{item.Photo}")"
                         class="img-fluid" style="max-height: 100%; object-fit: contain;" alt="@item.ProductName">
                </div>

                <div class="card-body d-flex flex-column">
                    <h6 class="card-title fw-bold text-dark text-truncate">@item.ProductName</h6>
                    <p class="small text-muted mb-2">ĐVT: @item.Unit</p>
                    <div class="mt-auto">
                        <span class="text-primary fw-bold fs-5 d-block mb-3">@item.Price.ToString("N0")đ</span>
                        <div class="d-flex gap-2">
                            <a href="/Product/Detail/@item.ProductID" class="btn btn-sm btn-outline-secondary w-100 fw-bold">Chi tiết</a>
                            <button class="btn btn-sm btn-primary w-100 fw-bold">Thêm</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>