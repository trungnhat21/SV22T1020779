@model AccountCustomer
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-sm text-center p-4 rounded-4" style="border: 2px solid #0d6efd !important;">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 shadow" style="width: 100px; height: 100px;">
                    <i class="fa-solid fa-key fa-3x"></i>
                </div>
                <h4 class="fw-bold mb-1">Bảo mật tài khoản</h4>
                <p class="text-muted small">Cập nhật mật khẩu định kỳ để bảo vệ túi tiền của bạn</p>
                <hr>
                <div class="d-grid gap-2">
                    <a href="/Account/Profile" class="btn btn-outline-secondary btn-sm text-start border-0 menu-link">
                        <i class="fa-solid fa-user me-2"></i> Thông tin cá nhân
                    </a>
                    <a href="/" class="btn btn-outline-secondary btn-sm text-start border-0 menu-link">
                        <i class="fa-solid fa-house me-2"></i> Trang chủ
                    </a>
                    <a href="/Account/Logout" class="btn btn-outline-danger btn-sm text-start border-0 menu-link-danger">
                        <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <h4 class="fw-bold text-primary mb-4 border-bottom pb-2">
                    <i class="fa-solid fa-shield-halved me-2"></i>THIẾT LẬP MẬT KHẨU MỚI
                </h4>

                <form action="/Account/ChangePassword" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 shadow-sm border-0 mb-4">
                            <ul class="mb-0 small ps-3">
                                @foreach (var modelState in ViewData.ModelState.Values)
                                {
                                    foreach (var error in modelState.Errors)
                                    {
                                        if (!error.ErrorMessage.Contains("required") && !error.ErrorMessage.Contains("field"))
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                        else if (error.ErrorMessage.Contains("Mật khẩu") || error.ErrorMessage.Contains("Vui lòng"))
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    }
                                }
                            </ul>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="text-muted small fw-bold mb-1">Mật khẩu hiện tại</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input type="password" name="oldPassword" class="form-control border-0 bg-light" placeholder="Nhập mật khẩu đang dùng" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small fw-bold mb-1">Mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="fa-solid fa-key text-muted"></i></span>
                            <input type="password" name="newPassword" class="form-control border-0 bg-light" placeholder="Tối thiểu 6 ký tự" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small fw-bold mb-1">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="fa-solid fa-check-double text-muted"></i></span>
                            <input type="password" name="confirmPassword" class="form-control border-0 bg-light" placeholder="Nhập lại mật khẩu mới" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="/Account/Profile" class="text-decoration-none small text-muted">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">
                            CẬP NHẬT NGAY
                        </button>
                    </div>
                </form>
            </div>

            <div class="mt-4 p-3 bg-light rounded border-start border-warning border-4">
                <p class="small text-muted mb-0">
                    <i class="fa-solid fa-lightbulb text-warning me-2"></i>
                    <strong>Mẹo:</strong> Mật khẩu mạnh nên bao gồm chữ cái, số và ký tự đặc biệt.
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        box-shadow: none;
        background-color: #fff !important;
        border: 1px solid #0d6efd !important;
    }

    .input-group-text, .form-control {
        border-radius: 8px;
    }

    .menu-link, .menu-link-danger {
        transition: all 0.3s ease;
        background: transparent !important;
    }

        .menu-link:hover {
            color: #0d6efd !important;
            font-weight: bold !important;
            padding-left: 1.25rem !important;
        }

        .menu-link-danger:hover {
            color: #dc3545 !important;
            font-weight: bold !important;
            padding-left: 1.25rem !important;
        }
</style>