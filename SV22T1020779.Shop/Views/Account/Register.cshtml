@model SV22T1020779.Models.AccountCustomer.RegistrationViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 p-4">
                <h3 class="text-center text-primary fw-bold mb-4">ĐĂNG KÝ TÀI KHOẢN</h3>

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold small">Họ và tên:</label>
                            <input type="text" asp-for="CustomerName" class="form-control" placeholder="Nhập họ tên" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold small">Tên giao dịch:</label>
                            <input type="text" asp-for="ContactName" class="form-control" placeholder="Nhập tên giao dịch" />
                            <span asp-validation-for="ContactName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold small">Tỉnh/Thành:</label>
                            <select asp-for="Province" class="form-control">
                                <option value="">-- Chọn tỉnh/thành --</option>
                                @if (Model.Provinces != null)
                                {
                                    foreach (var item in Model.Provinces)
                                    {
                                        <option value="@item.ProvinceName">@item.ProvinceName</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Province" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold small">Điện thoại:</label>
                            <input type="text" asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="fw-bold small">Email (Tài khoản):</label>
                            <input type="email" asp-for="Email" class="form-control" placeholder="Nhập email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold small">Mật khẩu:</label>
                            <input type="password" asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold small">Xác nhận mật khẩu:</label>
                            <input type="password" asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2">HOÀN TẤT ĐĂNG KÝ</button>
                    </div>

                    <div class="text-center mt-3">
                        <p class="small text-muted">Đã có tài khoản? <a href="/Account/Login">Đăng nhập ngay</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>