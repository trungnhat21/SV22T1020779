@model SV22T1020779.Models.Sales.OrderDetailViewInfo
@{
    Layout = null;
}
<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">Cập nhật chi tiết đơn hàng</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <form action="~/Order/UpdateCartItem" method="post" class="container-fluid">
        <input type="hidden" name="orderID" value="@Model.OrderID" />
        <input type="hidden" name="productID" value="@Model.ProductID" />

        <div class="row">
            <div class="col-md-7">
                <div class="mb-3">
                    <label class="fw-bold">Tên mặt hàng:</label>
                    <p class="form-control-plaintext text-primary fw-bold">@Model.ProductName</p>
                </div>
                <div class="mb-3">
                    <label class="fw-bold">Đơn vị tính:</label>
                    <p class="form-control-plaintext">@Model.Unit</p>
                </div>
                <div class="mb-3">
                    <label class="fw-bold">Số lượng:</label>
                    <input type="number" name="quantity" class="form-control"
                           min="1" value="@Model.Quantity" required>
                </div>
                <div class="mb-3">
                    <label class="fw-bold">Đơn giá bán:</label>
                    <input type="text" name="salePrice" class="form-control text-end money-input"
                           value="@Model.SalePrice.ToString("N0")">
                </div>
            </div>
            <div class="col-md-5 text-center">
                <label class="fw-bold d-block mb-2">Ảnh minh họa</label>
                <img src="~/images/products/@(string.IsNullOrEmpty(Model.Photo) ? "no-image.png" : Model.Photo)"
                     class="img-thumbnail" style="max-height: 200px;" />
            </div>
        </div>

        <div class="modal-footer px-0 pb-0">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Cập nhật
            </button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        </div>
    </form>
</div>

<script>

</script>