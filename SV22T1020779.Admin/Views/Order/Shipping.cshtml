@{
    Layout = null;
}
<div class="modal-header text-bg-info">
    <strong class="modal-title">
        <i class="bi bi-truck me-2"></i>Chọn người giao hàng
    </strong>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

@* Gửi dữ liệu về hàm Shipping trong OrderController *@
<form action="~/Order/Shipping/@ViewBag.OrderID" method="post">
    <div class="modal-body">
        <div class="row">
            <div class="col-12">
                <label class="form-label fw-bold">Đơn vị vận chuyển</label>
                <select class="form-select" name="shipperID" required>
                    <option value="">-- Chọn người giao hàng --</option>
                    @* Phải là item.ShipperID (số 1, 2, 3) *@
                    <option value="1">Giao hàng Tiết kiệm</option>
                    <option value="2">Tín Thành</option>
                    <option value="3">Viettel Express</option>
                </select>
                <div class="form-text mt-2 text-muted small">
                    <i>Sau khi xác nhận, khách hàng sẽ thấy tên shipper trên hóa đơn.</i>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        @* Nút này bây giờ nằm trong form nên sẽ thực hiện gửi dữ liệu *@
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-bicycle me-1"></i> Xác nhận giao hàng
        </button>
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Đóng
        </button>
    </div>
</form>